# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or MongoDB Atlas URI)
# Defaults to in-memory resilient fallback if MongoDB server is offline
MONGODB_URI=mongodb://127.0.0.1:27017/shop_express

# JWT Authentication Secret
JWT_SECRET=shop_express_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:5000

# Google OAuth Integration (Optional)
# Obtain credentials from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized JavaScript origins: http://localhost:5000
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
